{
  "name": "@workspace/skeleton",
  "private": true,
  "type": "module",
  "imports": {
    "#ui/*": "./src/client/components/ui/*.tsx",
    "#components/*": "./src/client/components/*.tsx",
    "#lib/*": "./src/client/lib/*.ts",
    "#hooks/*": "./src/client/hooks/*.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts",
    "./durable-objects": "./src/durable-objects.ts",
    "./i18n": "./src/i18n/index.ts",
    "./product": "./src/product.ts",
    "./styles.css": "./src/client/styles.css",
    "./vite": "./src/vite/index.ts",
    "./e2e": "./e2e/index.ts",
    "./drizzle": "./src/db/drizzle-config.ts",
    "./node": "./src/node/index.ts"
  },
  "bin": {
    "skeleton": "./bin/skeleton.ts"
  },
  "scripts": {
    "generate": "wrangler types test/worker/worker-configuration.d.ts -c test/worker/wrangler.jsonc && node bin/skeleton.ts generate",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.client.json",
    "lint": "oxlint && node bin/skeleton.ts migrations check-published && node bin/skeleton.ts migrations check-chain",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@better-auth/stripe": "catalog:",
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/workers-oauth-provider": "catalog:",
    "@faker-js/faker": "catalog:",
    "@fontsource-variable/geist": "catalog:",
    "@hono/swagger-ui": "catalog:",
    "@hono/zod-openapi": "catalog:",
    "@kubb/adapter-oas": "catalog:",
    "@kubb/plugin-faker": "catalog:",
    "@kubb/plugin-fetch": "catalog:",
    "@kubb/plugin-msw": "catalog:",
    "@kubb/plugin-react-query": "catalog:",
    "@kubb/plugin-ts": "catalog:",
    "@kubb/plugin-zod": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/router-generator": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@tanstack/virtual-file-routes": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "agents": "catalog:",
