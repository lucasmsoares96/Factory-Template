// A test-only composition of the Skeleton: the Worker every Skeleton
// integration test talks to. Products compose the same app in their own Worker.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "skeleton-test",
  "main": "./index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "PASSWORD_HASHER", "class_name": "PasswordHasher" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PasswordHasher"] }],
  "vars": { "EMAIL_TRANSPORT": "resend" },
  "secrets": { "required": ["DATABASE_URL", "BETTER_AUTH_SECRET"] }
}
