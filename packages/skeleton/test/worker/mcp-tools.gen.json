  {
    "name": "getNote",
    "title": "Get a note",
    "description": "Answers the note `welcome`; any other id is not found.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The note's id."
        },
        "shout": {
          "type": "string",
          "enum": [
            "yes",
            "no"
          ],
          "description": "`yes` upper-cases the text."
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The note's id."
        },
        "text": {
          "type": "string",
          "description": "What the note says."
        },
        "authorId": {
          "type": "string",
          "description": "The id of the user the request acts for."
        }
      },
      "required": [
        "id",
        "text",
        "authorId"
      ]
    },
    "annotations": {
      "title": "Get a note",
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "scope": "read",
    "http": {
      "method": "GET",
      "path": "/api/notes/{id}",
      "pathParams": [
