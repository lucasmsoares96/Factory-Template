      "output": "object"
    }
  },
  {
    "name": "getMe",
    "title": "Get the signed-in user",
    "description": "Answers the id, name and email of the user the request acts for, and the email they asked to change to, if any.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The user's id."
        },
        "name": {
          "type": "string",
          "description": "The user's name: the one they signed up with, or the last one they chose.",
          "example": "Ana Souza"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's verified email.",
          "example": "ana@example.com"
        },
        "pendingEmail": {
          "type": [
            "string",
            "null"
          ],
          "format": "email",
          "description": "The address the user asked to change their email to, until they open the link sent there; null when no change is pending.",
          "example": null
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "pendingEmail"
      ]
    },
    "annotations": {
      "title": "Get the signed-in user",
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "scope": "read",
    "http": {
      "method": "GET",
      "path": "/api/me",
      "pathParams": [],
      "queryParams": [],
      "body": false,
      "output": "object"
    }
  },
  {
    "name": "getNote",
    "title": "Get a note",
    "description": "Answers the note `welcome`; any other id is not found.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The note's id."
        },
        "shout": {
          "type": "string",
          "enum": [
            "yes",
            "no"
          ],
          "description": "`yes` upper-cases the text."
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The note's id."
        },
        "text": {
          "type": "string",
          "description": "What the note says."
        },
        "authorId": {
          "type": "string",
          "description": "The id of the user the request acts for."
        }
      },
      "required": [
        "id",
        "text",
        "authorId"
      ]
    },
    "annotations": {
      "title": "Get a note",
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "scope": "read",
    "http": {
      "method": "GET",
      "path": "/api/notes/{id}",
      "pathParams": [
        "id"
      ],
      "queryParams": [
        "shout"
      ],
      "body": false,
      "output": "object"
    }
  },
  {
