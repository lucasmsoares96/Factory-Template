        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's verified email.",
          "example": "ana@example.com"
        },
        "pendingEmail": {
          "type": [
            "string",
            "null"
          ],
          "format": "email",
          "description": "The address the user asked to change their email to, until they open the link sent there; null when no change is pending.",
          "example": null
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "pendingEmail"
      ]
    },
    "annotations": {
      "title": "Rename the signed-in user",
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    },
    "scope": "write",
    "http": {
      "method": "PATCH",
      "path": "/api/me",
      "pathParams": [],
      "queryParams": [],
      "body": true,
      "output": "object"
    }
  }
]
