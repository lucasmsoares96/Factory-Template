  {
    "name": "listCompanies",
    "title": "List the signed-in user's Companies",
    "description": "Answers the Companies the signed-in user is a Member of, with their role in each, in the order they joined: a page of `limit` (50 by default) and the `nextCursor` of the next page.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50,
          "description": "How many items to answer, 1 to 100.",
          "example": 50
        },
        "cursor": {
          "type": "string",
          "description": "The `nextCursor` of the previous page; without it, the first page.",
          "example": "WyIyMDI2LTEwLTI0VDEyOjAwOjAwLjAwMFoiLCJpZCJd"
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "The Company's id: random, and it never changes.",
                "example": "2f1c6a0e-8d1b-4a51-9f3e-6b0c1d2e3f40"
              },
              "name": {
                "type": "string",
                "description": "The Company's name; several Companies may share it.",
                "example": "Acme"
              },
              "role": {
                "type": "string",
                "description": "The signed-in user's role in the Company.",
                "example": "owner"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time",
                "description": "When the Company was created.",
                "example": "2026-10-24T12:00:00.000Z"
              }
            },
            "required": [
              "id",
              "name",
              "role",
              "createdAt"
            ]
          },
          "description": "This page's items."
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ],
          "description": "Pass it as `cursor` for the next page; `null` on the last page."
        }
      },
      "required": [
        "items",
        "nextCursor"
      ]
    },
    "annotations": {
      "title": "List the signed-in user's Companies",
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "scope": "read",
    "http": {
      "method": "GET",
      "path": "/api/companies",
      "pathParams": [],
      "queryParams": [
        "limit",
        "cursor"
      ],
      "body": false,
      "output": "object"
    }
  },
  {
    "name": "listConnections",
    "title": "List the signed-in user's Connections",
    "description": "Answers the AI agents the user the request acts for authorized over MCP: the app's name, when it was authorized and its access (`read` or `write`). Pages of `limit` (default 50); pass `nextCursor` back as `cursor` for the next one.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50,
          "description": "How many Connections per page, 1 to 100.",
          "example": 50
        },
        "cursor": {
          "type": "string",
          "description": "The `nextCursor` of the previous page.",
          "example": "AAAAANuhNPA"
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "connections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "The Connection's id: what revokeConnection takes.",
                "example": "Xk2pQ9vT4mWs1aLb"
              },
              "appName": {
                "type": "string",
                "description": "The name the agent's app gave itself when it connected.",
                "example": "Claude"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time",
                "description": "When the user authorized the agent.",
                "example": "2026-10-24T14:30:00.000Z"
              },
              "access": {
                "type": "string",
                "enum": [
                  "read",
                  "write"
                ],
                "description": "`read`: the agent only reads; `write`: it also changes data.",
                "example": "read"
              }
            },
            "required": [
              "id",
              "appName",
              "createdAt",
              "access"
            ]
          },
          "description": "One page of the user's Connections."
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ],
          "description": "Pass it as `cursor` for the next page; `null` on the last page.",
          "example": null
        }
      },
      "required": [
        "connections",
        "nextCursor"
      ]
    },
    "annotations": {
      "title": "List the signed-in user's Connections",
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "scope": "read",
    "http": {
      "method": "GET",
      "path": "/api/connections",
      "pathParams": [],
      "queryParams": [
        "limit",
        "cursor"
      ],
      "body": false,
      "output": "object"
    }
  },
