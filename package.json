{
  "name": "factory-template",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "pnpm --filter \"./apps/*\" dev",
    "generate": "turbo run generate",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "build": "turbo run build",
    "factory:verify": "node scripts/verify.ts",
    "factory": "node .factory/src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/skeleton": "workspace:*",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
