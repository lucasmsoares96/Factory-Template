{
  "name": "example",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "skeleton dev --product .",
    "generate": "wrangler types",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.app.json && tsc -p tsconfig.json",
    "lint": "oxlint && skeleton migrations check-published",
    "test": "skeleton db check --product .",
    "build": "vite build",
    "e2e": "vitest run --config vitest.e2e.config.ts",
    "db:migrate": "skeleton db migrate --product .",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@workspace/skeleton": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "drizzle-kit": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
