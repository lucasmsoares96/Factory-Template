  {
    "name": "createInvitation",
    "title": "Invite someone to a Company",
    "description": "The Owner invites an email address to the Company with a role (never `owner`). The Invitation lasts 7 days, and an email with its link goes to the address. Refused with 409 when the address is already a Member, or already has a pending Invitation (resend that one instead).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "companyId": {
          "type": "string",
          "description": "The Company's id.",
          "example": "2f1c6a0e-8d1b-4a51-9f3e-6b0c1d2e3f40"
        },
        "body": {
          "type": "object",
          "properties": {
            "email": {
              "type": "string",
              "format": "email",
              "description": "The address to invite.",
              "example": "bruno@example.com"
            },
            "role": {
              "type": "string",
              "description": "The role the person will have: any role of the Product but `owner`.",
              "example": "employee"
            }
          },
          "required": [
            "email",
            "role"
          ]
        }
      },
      "required": [
        "companyId",
        "body"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The Invitation's id.",
          "example": "6d0b9f3a-2c4e-4f1a-8b7d-1e2f3a4b5c6d"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The invited address, lowercase.",
          "example": "bruno@example.com"
        },
        "role": {
          "type": "string",
          "description": "The role the person will have: `employee` or a role the Product adds.",
          "example": "employee"
        },
        "invitedBy": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "userId": {
              "type": "string",
              "description": "The user id of whoever invited.",
              "example": "8yW1kQfV0d3sLx9bTq2nZ"
            },
            "name": {
              "type": "string",
              "description": "Their name.",
              "example": "Ana Souza"
            }
          },
          "required": [
            "userId",
            "name"
          ],
          "description": "Who invited; `null` once their account is deleted (the Invitation stays)."
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the link stops working, 7 days after it was sent or last resent.",
          "example": "2026-10-31T12:00:00.000Z"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the Invitation was created.",
          "example": "2026-10-24T12:00:00.000Z"
        }
      },
      "required": [
        "id",
        "email",
        "role",
        "invitedBy",
        "expiresAt",
        "createdAt"
      ]
    },
    "annotations": {
      "title": "Invite someone to a Company",
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    },
    "scope": "write",
    "http": {
      "method": "POST",
      "path": "/api/companies/{companyId}/invitations",
      "pathParams": [
        "companyId"
      ],
      "queryParams": [],
      "body": true,
      "output": "object"
    }
  },
