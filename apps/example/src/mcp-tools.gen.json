[
  {
    "name": "createCompany",
    "title": "Create a Company",
    "description": "Creates a Company with this name (the spaces around it are removed; names may repeat) and makes the signed-in user its Owner. Answers the new Company.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "body": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "description": "The Company's name: 1 to 100 characters once the spaces around it are removed.",
              "example": "Acme"
            }
          },
          "required": [
            "name"
          ]
        }
      },
      "required": [
        "body"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The Company's id: random, and it never changes.",
          "example": "2f1c6a0e-8d1b-4a51-9f3e-6b0c1d2e3f40"
        },
        "name": {
          "type": "string",
          "description": "The Company's name; several Companies may share it.",
          "example": "Acme"
        },
        "role": {
          "type": "string",
          "description": "The signed-in user's role in the Company.",
          "example": "owner"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the Company was created.",
          "example": "2026-10-24T12:00:00.000Z"
        }
      },
      "required": [
        "id",
        "name",
        "role",
        "createdAt"
      ]
    },
    "annotations": {
      "title": "Create a Company",
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    },
    "scope": "write",
    "http": {
      "method": "POST",
      "path": "/api/companies",
      "pathParams": [],
      "queryParams": [],
      "body": true,
      "output": "object"
    }
  },
