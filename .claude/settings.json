{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(/.github/workflows/**)",
      "Edit(/.agents/skills/**)",
      "Edit(/.claude/**)",
      "Edit(/skills-lock.json)",
      "Edit(/.mcp.json)",
      "Bash(pnpm bootstrap destroy:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-dangerous-git.mjs\""
          }
        ]
      }
    ]
  }
}
